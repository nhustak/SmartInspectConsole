<Window x:Class="SmartInspectConsole.Views.RemoteServersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Servers (SSH Attach)"
        Icon="/Resources/smartinspectconsole.png"
        Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinHeight="480" MinWidth="640"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" Click="OK_Click" Width="88"/>
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Width="88"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- List -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add" Click="Add_Click" Width="64"/>
                    <Button Content="Remove" Click="Remove_Click" Width="72"/>
                </StackPanel>
                <ListBox x:Name="ServersList"
                         DisplayMemberPath="DisplayLabel"
                         SelectionChanged="ServersList_SelectionChanged"/>
            </DockPanel>

            <!-- Editor -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="EditorPanel" IsEnabled="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Name:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox"/>

                    <Label Grid.Row="1" Content="SSH Host:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="HostBox"
                             ToolTip="Hostname or IP of the remote Windows server"/>

                    <Label Grid.Row="2" Content="SSH Port:"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="SshPortBox" Width="80" HorizontalAlignment="Left"/>

                    <Label Grid.Row="3" Content="SSH User:"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="UserBox"/>

                    <Label Grid.Row="4" Content="Auth:"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="AuthBox"
                              SelectionChanged="AuthBox_SelectionChanged">
                        <ComboBoxItem Content="privateKey" Tag="privateKey"/>
                        <ComboBoxItem Content="password" Tag="password"/>
                    </ComboBox>

                    <Label Grid.Row="5" Content="Private Key:"/>
                    <Grid Grid.Row="5" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="KeyPathBox"/>
                        <Button Grid.Column="1" Content="…" Click="BrowseKey_Click" Width="32" Padding="4,2"/>
                    </Grid>

                    <Label Grid.Row="6" Content="Key Passphrase:"/>
                    <PasswordBox Grid.Row="6" Grid.Column="1" x:Name="KeyPassBox"/>

                    <Label Grid.Row="7" Content="Password:"/>
                    <PasswordBox Grid.Row="7" Grid.Column="1" x:Name="PasswordBox"/>

                    <Label Grid.Row="8" Content="Remote API Port:"/>
                    <TextBox Grid.Row="8" Grid.Column="1" x:Name="RemoteApiPortBox" Width="80" HorizontalAlignment="Left"
                             ToolTip="SmartInspect Console local API on the server (default 42331, loopback)"/>

                    <Label Grid.Row="9" Content="Local Tunnel Port:"/>
                    <TextBox Grid.Row="9" Grid.Column="1" x:Name="LocalTunnelPortBox" Width="80" HorizontalAlignment="Left"
                             ToolTip="0 = auto-pick a free local port"/>

                    <Label Grid.Row="10" Content="Catch-up Limit:"/>
                    <TextBox Grid.Row="10" Grid.Column="1" x:Name="CatchUpBox" Width="80" HorizontalAlignment="Left"
                             ToolTip="Newest N log entries to pull when attaching"/>

                    <Label Grid.Row="11" Content="Poll Interval (ms):"/>
                    <TextBox Grid.Row="11" Grid.Column="1" x:Name="PollBox" Width="80" HorizontalAlignment="Left"/>

                    <CheckBox Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                              x:Name="EnabledBox" Content="Enabled (show in Attach menu)" Margin="0,8,0,0"/>

                    <TextBlock Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2"
                               TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                               Text="Attach opens an SSH tunnel from this PC to remote 127.0.0.1:API port, loads existing logs (catch-up), then polls for new entries. Remote SmartInspect Console must be running with its local API on that port."/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
